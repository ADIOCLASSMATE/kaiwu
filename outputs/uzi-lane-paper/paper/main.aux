\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Recall experiments. Several historical runs exposed Button9 and produced recall reward in synthetic low-HP safe states, but the final \texttt  {ppo-5-1} logs show Button9 count 0. The final system treats recall as a negative result rather than hiding it.}}{7}{figure.5}\protected@file@percent }
\newlabel{fig:recall}{{5}{7}{Recall experiments. Several historical runs exposed Button9 and produced recall reward in synthetic low-HP safe states, but the final \texttt {ppo-5-1} logs show Button9 count 0. The final system treats recall as a negative result rather than hiding it}{figure.5}{}}
