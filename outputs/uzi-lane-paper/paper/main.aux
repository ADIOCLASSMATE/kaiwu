\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Input feature processing. The environment frame is canonicalized into typed entity tokens, global context, target slots, and button-aware legal masks. The cake/rune icons sit behind the two outer towers, matching the 1v1 lane layout used by the feature builder.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:features}{{1}{2}{Input feature processing. The environment frame is canonicalized into typed entity tokens, global context, target slots, and button-aware legal masks. The cake/rune icons sit behind the two outer towers, matching the 1v1 lane layout used by the feature builder}{figure.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}Environment and action interface}{2}{section.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The Uzi policy uses structured entity tokens and global state, fuses them with a raw MLP pathway, applies an LSTM residual, and predicts multi-discrete actions. The target logits are conditioned on the selected top-level button, so target slots are interpreted in the same context as the chosen action. Generated 2D components provide visual icons; the module flow is drawn from the actual code path.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:architecture}{{2}{3}{The Uzi policy uses structured entity tokens and global state, fuses them with a raw MLP pathway, applies an LSTM residual, and predicts multi-discrete actions. The target logits are conditioned on the selected top-level button, so target slots are interpreted in the same context as the chosen action. Generated 2D components provide visual icons; the module flow is drawn from the actual code path}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Feature layout implemented in \texttt  {FeatureConfig}. Token dimensions are padded into a shared 542-dimensional token block before the 19-dimensional global block is appended.}}{3}{table.1}\protected@file@percent }
\newlabel{tab:feature-layout}{{1}{3}{Feature layout implemented in \texttt {FeatureConfig}. Token dimensions are padded into a shared 542-dimensional token block before the 19-dimensional global block is appended}{table.1}{}}
