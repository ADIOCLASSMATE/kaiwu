# Copy to .kaiwu-remote.env and adjust if your Kaiwu account uses different ids.
# Do not put passwords here; script read password.txt.

# Kaiwu context.
# Course experiments use KAIWU_DOMAIN_TYPE=course and KAIWU_DOMAIN_ID=<course_id>.
KAIWU_DOMAIN_TYPE=course
KAIWU_DOMAIN_ID=2383
KAIWU_TEAM_ID=6059
KAIWU_EXPERIMENT_ID=15823

# WebIDE port-proxy settings.
#
# This course WebIDE blocks general outbound network access from the container.
# Use the proxy commands, which run script/proxy_env_server.py inside WebIDE
# and access it through:
#   https://tencentarena.com/p5/ide/<experiment_id>/proxy/<port>/
KAIWU_PROXY_PORT=8765

# Remote Kaiwu project paths in WebIDE.
REMOTE_WORKSPACE=/data/projects/hok1v1
REMOTE_CODE_DIR=/workspace/code
